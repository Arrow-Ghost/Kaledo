---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Kaledo">
  <div class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center px-6 text-center">
    <span class="pill">404</span>
    <h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">
      This page wandered off <span class="gradient-text">the map.</span>
    </h1>
    <p class="mt-3 text-fg-muted">
      The page you're looking for doesn't exist, or the link is broken.
    </p>
    <a href="/" class="btn-primary mt-8">Back to home →</a>
  </div>
</Layout>
