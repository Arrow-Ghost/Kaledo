# Client-safe only. The anon/publishable key is meant to be public — real security
# comes from Postgres Row-Level Security, not from hiding this value.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Render Backend URL (set when backend is deployed to Render, e.g. https://kaledo-backend.onrender.com)
PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Note: Backend secrets (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, GEMINI_API_KEY)
# are configured in the Render Dashboard environment settings, never exposed in client code.
