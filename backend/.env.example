# Render Backend Environment Configuration
PORT=10000
NODE_ENV=production

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Frontend URL (Vercel deployment URL for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# Email Delivery via Resend (Optional - if omitted, OTPs log to console in dev mode)
RESEND_API_KEY=re_your_resend_api_key
VERIFICATION_EMAIL_FROM=Kaledo <verify@resend.dev>

# AI Gateway (Optional - for AI skill mapping & career recommendations)
GEMINI_API_KEY=your_gemini_api_key
